{
  "name": "otomad-daw",
  "private": true,
  "license": "GPL-3.0-or-later",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "npm run wasm && node scripts/prepare-ffmpeg-assets.mjs",
    "dev": "vite",
    "prebuild": "npm run wasm && node scripts/prepare-ffmpeg-assets.mjs",
    "build": "npm run panda:codegen && tsc -b && vite build && node scripts/check-ffmpeg-precache.mjs",
    "panda:codegen": "panda codegen && panda cssgen -o styled-system/styles.css",
    "preview": "vite preview",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "lint:deadcode": "node scripts/check-dead-code.mjs",
    "audit:dependencies": "npm audit --audit-level=high",
    "test": "npm run test:unit && npm run test:components",
    "test:unit": "node --test --experimental-strip-types \"src/**/*.test.ts\"",
    "test:components": "vitest run",
    "test:components:watch": "vitest",
    "wasm": "wasm-pack build --target web --out-dir ../ui/src/wasm ../core",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && wrangler deploy --env=\"\"",
    "deploy:preview": "npm run build && wrangler deploy --env preview"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "lucide-react": "^0.542.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@pandacss/dev": "^0.53.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.3.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "jsdom": "^28.1.0",
    "knip": "^6.32.0",
    "oxlint": "^1.77.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-wasm": "^3.4.1",
    "vitest": "^4.0.18",
    "wrangler": "^4.147.0"
  },
  "overrides": {
    "picomatch": "^4.0.5",
    "postcss": "^8.5.26"
  }
}
